# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# Entorno: desarrollo | pruebas | staging | produccion
ENTORNO=desarrollo
DOMINIO=localhost

# Base de datos. Si falta el driver, Settings agrega +asyncpg automáticamente.
DATABASE_URL=postgresql+asyncpg://carta:carta_dev_password@localhost:5432/carta_db
# Base de pruebas (pytest la migra con Alembic). Si falta, se usa `carta_test` en el mismo servidor.
# TEST_DATABASE_URL=postgresql+asyncpg://carta:carta_dev_password@localhost:5432/carta_test
DATABASE_ECHO=false

# Secreto de firma de cookies y tokens.
# Fuera de desarrollo debe tener al menos 32 caracteres y no ser el de ejemplo:
#   openssl rand -base64 32
SECRET_KEY=cambia-este-secreto-en-produccion

# Almacenamiento de archivos: Cloudflare R2 (API S3). Vacío = carpeta local ./datos
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLICO=
R2_BUCKET_PRIVADO=
R2_URL_PUBLICA=

# Importación de menús desde PDF (API de Claude)
ANTHROPIC_API_KEY=
IMPORTACION_MODELO=claude-opus-5-5

# Acceso de operadores (Firebase Auth: Google y enlace por correo)
FIREBASE_PROJECT_ID=

# Observabilidad
SENTRY_DSN=
