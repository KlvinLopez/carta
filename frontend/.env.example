# Configuración web de Firebase Auth (consola de Firebase → Configuración del proyecto → Tus apps).
# La configuración web no es secreta, pero tampoco se inventa: estos valores son de ejemplo.
# Cópiala a frontend/.env.local para desarrollo; en CI/producción entra como variables de build.
VITE_FIREBASE_API_KEY=AIza-ejemplo
VITE_FIREBASE_AUTH_DOMAIN=mi-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mi-proyecto
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
