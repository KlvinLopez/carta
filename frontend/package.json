{
  "name": "carta-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "PWA de Carta: comensal (/m), personal (/staff) y operador (/admin) en una sola SPA",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tipos": "openapi-typescript http://localhost:8000/openapi.json -o src/compartido/api.d.ts",
    "presupuesto": "node scripts/presupuesto.mjs",
    "contrato": "cd .. && uv run python -c \"import json; from app.main import app; print(json.dumps(app.openapi(), sort_keys=True))\" > frontend/src/mocks/openapi.json",
    "sincronizar": "node scripts/sincronizar-contrato.mjs"
  },
  "dependencies": {
    "firebase": "13.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.17.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
